<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="memberMapper">
	
	<!--
		MEMBER 테이블로부터 조회된 ResultSet 결과를
		자바의 Member VO 클래스로 가공해주는 ResultMap
	-->
	<resultMap type="member" id="memberResultSet">
		<id column="USER_ID" id="userId" />
		<result column="USER_NAME" id="userName" />
		<result column="EMAIL" id="email" />
		<result column="GENDER" id="gender" />
		<result column="AGE" id="age" />
		<result column="ENROLL_DATE" id="enrollDate" />
		<result column="STATUS" id="status" />
	</resultMap>
	
	<!-- 회원 목록 조회용 쿼리문 -->
	<select id="selectMemberMapper" resultMap="memberResultSet">
		SELECT USER_ID
			 , USER_NAME
			 , EMAIL
			 , GENDER
			 , AGE
			 , ENROLL_DATE
			 , STATUS 
		  FROM MEMBER
		 WHERE USER_ID != 'admin'
		 ORDER BY ENROLL_DATE ASC
	</select>
	
	<!--  -->
	<select id="selectMember" parameterType="string">
	</select>
	
	
</mapper>